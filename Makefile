#---------------------------
#---------------------------
# VARIABLES
#---------------------------
#---------------------------

# bash from the PATH: /usr/bin/bash on Ubuntu, Homebrew bash on MacOS (if installed)
SHELL := /usr/bin/env bash

CLUSTER_NAME := kind-multinodes

# Every CLI used by this repository (kind, kubectl, helm, argocd, cmctl, jq) is pinned in
# mise.toml and executed through mise, so the versions don't depend on what is in the PATH
MISE_EXEC := mise exec --

# Installed outside of mise (see REQUIREMENTS.md)
SYSTEM_PACKAGES := mise docker curl gpg sudo

# Ubuntu releases supported by this repository (see softwares-ubuntu.md)
SUPPORTED_UBUNTU_VERSIONS := 22.04 24.04 26.04
#----------------------------------------------------------------------------------------------------------


#---------------------------
#---------------------------
# MAIN
#---------------------------
#---------------------------

# References
# https://mise.jdx.dev/
# https://makefiletutorial.com/
# https://til.hashrocket.com/posts/k3kjqxtppx-escape-dollar-sign-on-makefiles

.PHONY: help requirements tools helm-plugins up down recreate

help:
	@echo "make requirements  # check system packages and install the tools of mise.toml"
	@echo "make tools         # install the tools of mise.toml (mise install)"
	@echo "make helm-plugins  # optional: install helm-diff and helm-secrets (mise run helm-plugins)"
	@echo "make up            # create the kind cluster and install every application"
	@echo "make down          # delete the kind cluster"
	@echo "make recreate      # down + up"

requirements:
	@if [ -r /etc/os-release ]; then \
	  . /etc/os-release; \
	  if [ "$$ID" = "ubuntu" ]; then \
	    case " $(SUPPORTED_UBUNTU_VERSIONS) " in \
	      *" $$VERSION_ID "*) echo "Found Ubuntu $$VERSION_ID" ;; \
	      *) echo "[WARNING] Ubuntu $$VERSION_ID is not tested. Supported versions: $(SUPPORTED_UBUNTU_VERSIONS) (see softwares-ubuntu.md)" ;; \
	    esac; \
	  fi; \
	fi
	@for package in $(SYSTEM_PACKAGES); do \
	  command -v $$package >/dev/null 2>&1 || { echo "[ERROR] Please install '$$package' (see REQUIREMENTS.md)"; exit 1; }; \
	  echo "Found '$$package'"; \
	done
	@docker info >/dev/null 2>&1 || { echo "[ERROR] docker is not running or not accessible by $$USER (on MacOS, run 'colima start', see softwares-macos.md)"; exit 1; }
	@$(MAKE) --no-print-directory tools
	@HELM_VERSION=$$($(MISE_EXEC) helm version --template '{{.Version}}'); \
	  [[ "$$HELM_VERSION" == v4.* ]] || { echo "[ERROR] Helm 4 is required, found '$$HELM_VERSION'. Check mise.toml"; exit 1; }; \
	  echo "Found 'helm' $$HELM_VERSION"

tools:
	mise install

helm-plugins: tools
	mise run helm-plugins

up: requirements
	chmod +x run.sh
	$(MISE_EXEC) ./run.sh

down: requirements
	$(MISE_EXEC) kind delete clusters $(CLUSTER_NAME)
	# Remove the files generated by run.sh, so the next "make up" recreates them from the current run.sh
	rm -f /tmp/kind-cluster.yaml /tmp/metallb-ingress-address.yaml /tmp/cert-cluster-issue.yaml

recreate:
	$(MAKE) down
	$(MAKE) up
